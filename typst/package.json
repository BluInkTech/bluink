{
	"name": "@bluink/typst",
	"version": "26.10.2",
	"description": "Pinned offline Typst binaries for Bluink PDF generation",
	"private": true,
	"type": "module",
	"license": "MPL-2.0",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.js"
		}
	},
	"files": [
		"index.js",
		"index.d.ts",
		"assets",
		"sources.json",
		"LICENSE",
		"README.md",
		"licenses"
	],
	"devDependencies": {
		"@biomejs/biome": "2.5.1"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"test": "node --test tests/*.test.mjs",
		"lint": "biome lint --config-path ../backend .",
		"format": "biome format --config-path ../backend --write ."
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/BluInkTech/bluink.git",
		"directory": "typst"
	},
	"homepage": "https://bluink.app"
}
