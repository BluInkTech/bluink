{
  "schemaVersion": 1,
  "id": "portable-classic",
  "version": "1.0.0",
  "name": "Portable Classic",
  "tokens": {
    "body-font": { "type": "font", "value": "source-serif-4" },
    "heading-font": { "type": "font", "value": "source-sans-3" },
    "code-font": { "type": "font", "value": "ibm-plex-mono" },
    "root-size": { "type": "length", "value": "12pt" },
    "body-size": { "type": "length", "value": "1rem" },
    "paragraph-gap": { "type": "length", "value": "0.75rem" },
    "leading": { "type": "number", "value": 1.5 },
    "ink": { "type": "color", "value": "#20252b" },
    "blue": { "type": "color", "value": "#254fa8" },
    "link": { "type": "color", "value": { "ref": "blue" } }
  },
  "root": { "fontSize": { "ref": "root-size" } },
  "colors": {
    "ink": { "ref": "ink" },
    "muted": "#53606d",
    "link": { "ref": "link" },
    "accent": { "ref": "blue" },
    "surface": "#f0f3f8",
    "paper": "#ffffff"
  },
  "styles": {
    "body": {
      "fontFamily": { "ref": "body-font" },
      "fontSize": { "ref": "body-size" },
      "lineHeight": { "ref": "leading" },
      "spaceAfter": { "ref": "paragraph-gap" }
    },
    "heading1": { "fontFamily": { "ref": "heading-font" }, "fontSize": "2rem", "fontWeight": "bold", "lineHeight": 1.2, "spaceBefore": "2rem", "keepWithNext": true },
    "heading2": { "fontFamily": { "ref": "heading-font" }, "fontSize": "1.6rem", "fontWeight": "bold", "keepWithNext": true },
    "heading3": { "fontFamily": { "ref": "heading-font" }, "fontSize": "1.3rem", "fontWeight": "bold", "keepWithNext": true },
    "heading4": { "fontFamily": { "ref": "heading-font" }, "fontSize": "1.15rem", "fontWeight": "bold", "keepWithNext": true },
    "heading5": { "fontFamily": { "ref": "heading-font" }, "fontSize": "1rem", "fontWeight": "bold", "keepWithNext": true },
    "heading6": { "fontFamily": { "ref": "heading-font" }, "fontSize": "0.9rem", "fontWeight": "bold", "keepWithNext": true },
    "link": { "color": { "ref": "link" } },
    "quote": { "italic": true, "indent": "1.5rem", "borderWidth": "1pt", "padding": "0.75rem" },
    "code": { "fontFamily": { "ref": "code-font" }, "fontSize": "0.85rem", "background": "#f0f3f8", "padding": "1rem", "keepTogether": true },
    "inlineCode": { "fontFamily": { "ref": "code-font" }, "fontSize": "0.9rem" },
    "list": { "indent": "1.5rem" },
    "table": { "borderWidth": "0.5pt", "spaceAfter": "1rem" },
    "tableHeader": { "fontWeight": "bold", "background": "#f0f3f8", "padding": "0.4rem" },
    "tableCell": { "padding": "0.4rem" },
    "caption": { "fontSize": "0.9rem", "color": "#53606d", "captionPosition": "after" },
    "footnote": { "fontSize": "0.8rem" },
    "embed": {},
    "rule": { "borderWidth": "0.5pt", "spaceBefore": "1rem", "spaceAfter": "1rem" },
    "box": { "background": "#f0f3f8", "borderWidth": "0.5pt", "padding": "1rem" },
    "boxHeading": { "fontWeight": "bold", "keepWithNext": true },
    "boxInfo": {},
    "boxAbstract": {},
    "boxNote": {},
    "boxTip": {},
    "boxSuccess": {},
    "boxImportant": {},
    "boxWarning": {},
    "boxError": {},
    "boxQuestion": {},
    "boxExample": {}
  },
  "page": {
    "width": "210mm",
    "height": "297mm",
    "orientation": "portrait",
    "marginTop": "25mm",
    "marginRight": "25mm",
    "marginBottom": "25mm",
    "marginLeft": "25mm",
    "headerDistance": "12mm",
    "footerDistance": "12mm",
    "chapterStart": "next-page",
    "header": { "left": [{ "kind": "documentTitle" }], "center": [], "right": [{ "kind": "chapterTitle" }], "showOnFirstPage": false },
    "footer": { "left": [], "center": [{ "kind": "pageNumber" }, { "kind": "text", "text": " / " }, { "kind": "pageCount" }], "right": [], "showOnFirstPage": false },
    "measureCharacters": 72
  },
  "targets": {},
  "web": {}
}
