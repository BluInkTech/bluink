{
	"format": "bluink.workspace-setup",
	"version": 1,
	"name": "Content calendar",
	"summary": "Ideas, scheduled pieces by date, and what went out.",
	"description": "Plan posts, issues and episodes across channels: collect ideas, give each piece a publish date, and keep a record of what went out.",
	"properties": [
		{
			"key": "content_status",
			"valueType": "select",
			"options": [
				"drafting",
				"idea",
				"published",
				"scheduled"
			],
			"optionAppearance": {
				"idea": {
					"color": "neutral"
				},
				"drafting": {
					"color": "blue"
				},
				"scheduled": {
					"color": "purple"
				},
				"published": {
					"color": "green"
				}
			}
		},
		{
			"key": "channel",
			"valueType": "select",
			"options": [
				"blog",
				"newsletter",
				"podcast",
				"social",
				"video"
			]
		},
		{
			"key": "publish_date",
			"valueType": "date"
		}
	],
	"templates": [
		{
			"key": "post",
			"title": "Post",
			"values": {
				"content_status": "idea"
			},
			"propertyKeys": [
				"channel",
				"publish_date"
			],
			"document": {
				"type": "doc",
				"content": [
					{
						"type": "heading",
						"attrs": {
							"level": 2
						},
						"content": [
							{
								"type": "text",
								"text": "Angle"
							}
						]
					},
					{
						"type": "paragraph",
						"content": [
							{
								"type": "text",
								"text": "Who is it for, and what will they take away?"
							}
						]
					},
					{
						"type": "heading",
						"attrs": {
							"level": 2
						},
						"content": [
							{
								"type": "text",
								"text": "Outline"
							}
						]
					},
					{
						"type": "list",
						"attrs": {
							"kind": "bullet"
						},
						"content": [
							{
								"type": "listItem",
								"content": [
									{
										"type": "paragraph",
										"content": [
											{
												"type": "text",
												"text": "Hook"
											}
										]
									}
								]
							},
							{
								"type": "listItem",
								"content": [
									{
										"type": "paragraph",
										"content": [
											{
												"type": "text",
												"text": "Point"
											}
										]
									}
								]
							},
							{
								"type": "listItem",
								"content": [
									{
										"type": "paragraph",
										"content": [
											{
												"type": "text",
												"text": "Call to action"
											}
										]
									}
								]
							}
						]
					}
				]
			}
		},
		{
			"key": "issue",
			"title": "Newsletter issue",
			"values": {
				"content_status": "drafting",
				"channel": "newsletter"
			},
			"propertyKeys": [
				"publish_date"
			],
			"document": {
				"type": "doc",
				"content": [
					{
						"type": "heading",
						"attrs": {
							"level": 2
						},
						"content": [
							{
								"type": "text",
								"text": "This issue"
							}
						]
					},
					{
						"type": "paragraph",
						"content": [
							{
								"type": "text",
								"text": "One line on the theme."
							}
						]
					},
					{
						"type": "heading",
						"attrs": {
							"level": 2
						},
						"content": [
							{
								"type": "text",
								"text": "Sections"
							}
						]
					},
					{
						"type": "list",
						"attrs": {
							"kind": "bullet"
						},
						"content": [
							{
								"type": "listItem",
								"content": [
									{
										"type": "paragraph",
										"content": [
											{
												"type": "text",
												"text": "Lead story"
											}
										]
									}
								]
							},
							{
								"type": "listItem",
								"content": [
									{
										"type": "paragraph",
										"content": [
											{
												"type": "text",
												"text": "Links worth reading"
											}
										]
									}
								]
							},
							{
								"type": "listItem",
								"content": [
									{
										"type": "paragraph",
										"content": [
											{
												"type": "text",
												"text": "What’s next"
											}
										]
									}
								]
							}
						]
					}
				]
			}
		}
	],
	"workspace": {
		"title": "Content calendar",
		"summary": "Ideas, scheduled pieces and what went out.",
		"icon": {
			"kind": "symbol",
			"name": "calendar-blank"
		},
		"color": "amber",
		"cover": {
			"kind": "gradient",
			"name": "dawn"
		},
		"query": {
			"version": 1,
			"clauses": [
				{
					"polarity": "required",
					"predicate": {
						"kind": "field",
						"field": "type",
						"operator": "match",
						"value": "page"
					}
				},
				{
					"polarity": "required",
					"predicate": {
						"kind": "field",
						"field": "state",
						"operator": "match",
						"value": "active"
					}
				},
				{
					"polarity": "required",
					"predicate": {
						"kind": "has",
						"field": "content_status"
					}
				}
			],
			"sort": [
				{
					"field": "title",
					"direction": "asc"
				}
			]
		},
		"widgets": [
			{
				"title": "How it works",
				"home": {
					"span": 12,
					"height": "compact"
				},
				"config": {
					"kind": "introduction",
					"title": "",
					"description": "Each piece moves from idea to published. Give it a channel and a publish date; the calendar in the navigator shows what goes out when."
				}
			},
			{
				"title": "Start",
				"home": {
					"span": 8,
					"height": "compact"
				},
				"config": {
					"kind": "create_buttons",
					"templateIds": [
						"post",
						"issue"
					]
				}
			},
			{
				"title": "Scheduled",
				"home": {
					"span": 4,
					"height": "compact"
				},
				"config": {
					"kind": "count",
					"query": {
						"version": 1,
						"clauses": [
							{
								"polarity": "required",
								"predicate": {
									"kind": "field",
									"field": "content_status",
									"operator": "match",
									"value": "scheduled"
								}
							}
						],
						"sort": []
					}
				}
			},
			{
				"title": "Pipeline",
				"home": {
					"span": 12,
					"height": "regular"
				},
				"config": {
					"kind": "layout",
					"query": {
						"version": 1,
						"clauses": [],
						"sort": []
					},
					"mode": "kanban",
					"kanban": {
						"groupBy": "meta.content_status",
						"columns": [
							{
								"id": "idea"
							},
							{
								"id": "drafting"
							},
							{
								"id": "scheduled"
							},
							{
								"id": "published"
							}
						]
					},
					"cards": {
						"version": 1,
						"media": {
							"position": "none",
							"height": 176,
							"fit": "cover"
						},
						"titleLines": 2,
						"header": {
							"start": {
								"field": "meta.publish_date",
								"show": "text"
							}
						},
						"body": [
							{
								"start": {
									"field": "summary",
									"show": "text",
									"lines": 2
								}
							}
						],
						"footer": {
							"start": {
								"field": "meta.channel",
								"show": "chips",
								"maxItems": 1
							}
						}
					}
				}
			},
			{
				"title": "Scheduled",
				"home": {
					"span": 8,
					"height": "regular"
				},
				"config": {
					"kind": "layout",
					"query": {
						"version": 1,
						"clauses": [
							{
								"polarity": "required",
								"predicate": {
									"kind": "field",
									"field": "content_status",
									"operator": "match",
									"value": "scheduled"
								}
							}
						],
						"sort": []
					},
					"mode": "table",
					"table": {
						"columns": [
							{
								"field": "title"
							},
							{
								"field": "channel"
							},
							{
								"field": "publish_date",
								"label": "Goes out"
							}
						]
					}
				}
			},
			{
				"home": {
					"span": 4,
					"height": "regular"
				},
				"config": {
					"kind": "tasks",
					"status": "open",
					"count": 5
				}
			},
			{
				"title": "Published",
				"home": {
					"span": 12,
					"height": "compact"
				},
				"config": {
					"kind": "layout",
					"query": {
						"version": 1,
						"clauses": [
							{
								"polarity": "required",
								"predicate": {
									"kind": "field",
									"field": "content_status",
									"operator": "match",
									"value": "published"
								}
							}
						],
						"sort": []
					},
					"mode": "table",
					"table": {
						"columns": [
							{
								"field": "title"
							},
							{
								"field": "channel"
							},
							{
								"field": "publish_date",
								"label": "Went out"
							}
						]
					}
				}
			},
			{
				"title": "By channel",
				"topBar": true,
				"home": {
					"span": 12,
					"height": "tall",
					"hidden": true
				},
				"config": {
					"kind": "layout",
					"query": {
						"version": 1,
						"clauses": [],
						"sort": []
					},
					"mode": "kanban",
					"kanban": {
						"groupBy": "meta.channel",
						"columns": [
							{
								"id": "blog"
							},
							{
								"id": "newsletter"
							},
							{
								"id": "podcast"
							},
							{
								"id": "social"
							},
							{
								"id": "video"
							}
						]
					},
					"cards": {
						"version": 1,
						"media": {
							"position": "none",
							"height": 176,
							"fit": "cover"
						},
						"titleLines": 2,
						"header": {
							"start": {
								"field": "modified",
								"show": "text"
							}
						},
						"body": [
							{
								"start": {
									"field": "summary",
									"show": "text",
									"lines": 2
								}
							}
						]
					}
				}
			},
			{
				"title": "Table",
				"topBar": true,
				"home": {
					"span": 12,
					"height": "tall",
					"hidden": true
				},
				"config": {
					"kind": "layout",
					"query": {
						"version": 1,
						"clauses": [],
						"sort": []
					},
					"mode": "table",
					"table": {
						"columns": [
							{
								"field": "title"
							},
							{
								"field": "content_status"
							},
							{
								"field": "channel"
							},
							{
								"field": "publish_date"
							}
						]
					}
				}
			}
		],
		"templates": {
			"offered": [
				"post",
				"issue"
			],
			"default": "post"
		},
		"calendar": {
			"dateField": "meta.publish_date"
		}
	}
}
