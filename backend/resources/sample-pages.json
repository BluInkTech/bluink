          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "Write once, publish anywhere"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "These sample pages hold every kind of content you can write: a type scale, lists, tables, images, code, boxes, notes and references."
          }
        ],
        "attrs": {
          "id": "00000000-0000-7000-8000-000000001001"
        }
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Explore "
          },
          {
            "type": "text",
            "text": "typography and structure",
            "marks": [
              {
                "type": "link",
                "attrs": {
                  "href": "/?note=00000000-0000-7000-8000-000000000903"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " and "
          },
          {
            "type": "text",
            "text": "boxes and references",
            "marks": [
              {
                "type": "link",
                "attrs": {
                  "href": "/?note=00000000-0000-7000-8000-000000000904"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ". The same content appears in every format."
          }
        ],
        "attrs": {
          "id": "00000000-0000-7000-8000-000000001002"
        }
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A shared source can be cited more than once "
          },
          {
            "type": "citation",
            "attrs": {
              "source": "snippet",
              "snippetId": "theme_reference"
            }
          },
          {
            "type": "text",
            "text": " without duplicating its definition."
          }
        ],
        "attrs": {
          "id": "00000000-0000-7000-8000-000000001003"
        }
      },
      {
        "type": "box",
        "attrs": {
          "kind": "note",
          "id": "00000000-0000-7000-8000-000000001004"
        },
        "content": [
          {
            "type": "boxHeading",
            "content": [
              {
                "type": "text",
                "text": "A portable visual language"
              }
            ],
            "attrs": {
              "id": "00000000-0000-7000-8000-000000001005"
            }
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Relative sizes follow the root font size. Physical paper and margins remain consistent across print formats."
              }
            ],
            "attrs": {
              "id": "00000000-0000-7000-8000-000000001006"
            }
          }
        ]
      }
    ]
